                "query": {
                  "datasetName": "ad946c4c",
                  "fields": [
                    {
                      "name": "monthly(PostCreationDate)",
                      "expression": "DATE_TRUNC(\"MONTH\", `PostCreationDate`)"
                    },
                    {
                      "name": "count(PostId)",
                      "expression": "COUNT(`PostId`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "line",
