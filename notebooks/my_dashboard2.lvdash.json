    {
      "name": "367e857c",
      "displayName": "Answer Scores and Reputation by User Overview",
      "queryLines": [
        "select avg(score) as average_answer_score,Reputation,Id as UserId\n",
        "from marts_posts_users\n",
        "where PostType='Answer'\n",
        "group by Id,Reputation\n",
        "having sum(Score)>0"
      ]
    }
